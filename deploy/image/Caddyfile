# Caddy reverse proxy for the prebuilt preview-host image.
#
# {$DOMAIN} comes from .env via docker-compose. With a public DNS A record
# pointing at the host, Caddy provisions + renews a Let's Encrypt cert
# automatically. The app's token (?token= / X-Compose-Preview-Token) stays the
# auth gate; this only adds TLS and forwards to the internal server.
#
# {$SITE_DOMAINS} carries the TOP-LEVEL SITE hostnames. They belong on this same
# line: the app tells the catalogs apart by the Host header, so every name proxies
# to the one upstream — but Caddy only matches a name, and only provisions a
# certificate for it, if the name is listed here. Without it a site is configured
# in the app and unreachable at the edge.
#
# The value is RESOLVED BY THE ENTRYPOINT (caddy-entrypoint.sh), not by the
# operator: it reads the `sites` list out of the preview server's own catalogs.json
# — mounted read-only at /srv/preview-config — and unions it with any explicit
# SITE_DOMAINS. So the committed file both routes a site and gets it a certificate,
# instead of the two being kept in step by hand in an untracked .env. Each name
# still needs its own DNS record. Empty (the default) leaves this block exactly as
# it was.
{$DOMAIN} {$SITE_DOMAINS:} {
	encode zstd gzip

	# Access log. There was none, and its absence is not neutral: with only warnings
	# reaching stdout, `docker logs caddy` returns nothing for a window in which the
	# box served real traffic, which reads as "no requests" rather than "no logging".
	# That misreading turned a user-facing incident — interactive renders aborting
	# after 2-8s while background optimization held the CPU — into an apparently idle
	# host, because the aborted requests were invisible and only the load was not.
	#
	# stdout (not a file) so it lands in the json-file driver the compose `x-logging`
	# anchor now caps; without that cap this would grow unbounded.
	#
	# The `filter` encoder keeps credentials out of that log. Caddy already masks
	# Cookie, Set-Cookie, Authorization and Proxy-Authorization; the app's own token
	# headers are deleted here, and the `token` query parameter (every shared link
	# carries it) plus the OAuth callback's `code` and `state` are replaced in the
	# logged URI. The same parameters are masked in a logged Referer, because a page
	# opened with `?token=` sends its full URL as the Referer of its same-origin
	# sub-requests, and in a logged `Location`, because a redirect keeps the query. Everything else — method, host, path, status, timings, client IP,
	# User-Agent — is logged as before.
	log {
		output stdout
		format filter {
			wrap json
			request>headers>X-Compose-Preview-Admin-Token delete
			request>headers>X-Compose-Preview-Token delete
			request>headers>X-Compose-Preview-Agent-Access delete
			request>uri query {
				replace token REDACTED
				replace code REDACTED
				replace state REDACTED
			}
			request>headers>Referer query {
				replace token REDACTED
				replace code REDACTED
				replace state REDACTED
			}
			resp_headers>Location query {
				replace token REDACTED
				replace code REDACTED
				replace state REDACTED
			}
		}
	}

	# Response headers for every page this host serves. `?` sets each one only when the
	# app has not set it itself, so a route can still choose its own value.
	#   * Referrer-Policy same-origin: a link out to GitHub (or anywhere else) sends no
	#     Referer, so a `?token=` URL stays on this host; same-origin requests keep the
	#     full Referer the app's own pages rely on.
	#   * Strict-Transport-Security: this block only ever serves HTTPS (Caddy redirects
	#     :80), so browsers are told to skip the http:// hop next time. No
	#     includeSubDomains — sibling hosts under the same parent are not ours to pin.
	#   * X-Content-Type-Options nosniff: the app labels its JS/Wasm/CSS explicitly
	#     (ServeHttpServer's asset content types), so nothing depends on sniffing.
	header {
		?Referrer-Policy same-origin
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options nosniff
	}

	# X-Frame-Options SAMEORIGIN on everything EXCEPT the pages that are framed by design:
	#   * /iframe.html and /<system>/iframe.html — the Storybook-compatible isolated
	#     story render, which a Storybook host on another origin embeds (composition) and
	#     screenshot tools load in a frame.
	#   * /wasm/* and /ui-builder/runtime/* — mounted in sandboxed (opaque-origin)
	#     iframes by the viewer and the UI builder editor. Their parent is same-origin,
	#     but a frame nested inside an opaque-origin one would fail a SAMEORIGIN check,
	#     and these are generic client bundles already served with ACAO:* for that
	#     sandbox, so they are left frameable.
	# No Content-Security-Policy here: the pages carry inline scripts and styles, and a
	# policy for them belongs in the app next to the markup it describes.
	@sameOriginFramesOnly not path /iframe.html /*/iframe.html /wasm/* /ui-builder/runtime/*
	header @sameOriginFramesOnly ?X-Frame-Options SAMEORIGIN

	# meta-externalagent is blocked outright. It ignores robots.txt, and on this box it
	# was not a tax on serving — it WAS the load.
	#
	# Measured over ~20k logged requests: 18,855 of them, 94% of ALL traffic, ~4.7 req/s
	# sustained. Among them 4,126 /reference/, 2,356 /rc-compare/, 481 /compare, 342
	# /api/ and 30 /playground — every one Disallowed by the robots.txt this server
	# generates itself (ServeSiteIndex.robotsTxt), whose Crawl-delay: 10 it also ignores.
	#
	# Why it took the box down rather than merely slowing it: each catalog URL it walked
	# OPENED that catalog's render daemon (~1.1 GB resident, 3 Robolectric sandboxes).
	# It walked m3-catalog, remote-m3, wear-m3-catalog, horologist, m3-samples,
	# compose-m3, meshcore-mobile and homeassistant-remotecompose — exactly the resident
	# set that filled the container and had the kernel OOM-kill the serve JVM every
	# 20-60 min. Raising PREVIEW_MEM_LIMIT 16g -> 24g only bought it more room to fill,
	# because nothing sheds a resident daemon until #898 ships.
	#
	# THE COST, accepted deliberately: meta-externalagent is also Meta's link UNFURLER,
	# so Facebook/WhatsApp/Instagram previews of shared preview URLs stop resolving —
	# which is precisely what robots.txt's PREVIEW_FETCHERS carve-out exists to allow,
	# and this rule overrides it. To restore unfurling while keeping the relief, narrow
	# the matcher from `*` to the expensive lanes only:
	#     @metabot header User-Agent *meta-externalagent*
	#     @metalanes path /render/* /*/render/* /reference/* /*/reference/* /api/* ...
	# and gate on both. Left blunt for now because the box was actively OOM-looping.
	@metabot header User-Agent *meta-externalagent*
	handle @metabot {
		respond "blocked: this crawler ignores robots.txt" 403
	}

	# Deploy webhook: the image-publish CI POSTs here to roll `preview` immediately
	# when a new image is published (instead of waiting for the rollout poll). Routed
	# to the `hook` sidecar, which enforces the bearer-token check and runs a
	# single-flight rollout.sh — Caddy only forwards; the auth gate lives in the hook.
	# `handle` (not a bare directive) so this one path peels off before the catch-all
	# proxy below. The hook is fail-closed (idle without DEPLOY_HOOK_TOKEN), and only
	# reachable here — it publishes no host port of its own.
	handle /__hooks/rollout {
		reverse_proxy hook:9000
	}

	# Everything else → the preview server.
	handle {
		# The /ws/ WebSocket frame lane (Live Compose) was 502ing: a `read_timeout` on
		# the http transport puts a read deadline on the upstream connection and fails
		# the WebSocket upgrade before a 101 is produced. Dropping it fixes the upgrade —
		# WebSockets are proxied by connection hijack (no read deadline, no response
		# buffering involved), and long cold renders are already bounded by the app's own
		# --timeout, so the proxy needn't cap the read. Bound only the initial dial.
		#
		# Deliberately NOT `flush_interval -1`: a negative flush interval disables
		# response buffering globally AND, per Caddy's reverse_proxy docs, does not cancel
		# the upstream request on client disconnect — an abandoned /render/*.png|svg tab
		# would then hold a render slot for the whole cold-render budget. WS doesn't need
		# it (hijacked); render endpoints must keep cancel-on-disconnect.
		reverse_proxy {
			# Zero-downtime rollout support. During a docker-rollout swap the `preview`
			# service briefly has TWO replicas (old still serving + new booting), then one
			# again. Resolve the service name via Docker's embedded DNS (127.0.0.11 inside
			# the compose network) on a short refresh so the upstream set tracks that
			# without a Caddy reload — a plain `reverse_proxy preview:8080` resolves once
			# and would keep pointing at the retired container.
			dynamic a {
				name preview
				port 8080
				refresh 3s
				resolvers 127.0.0.11
			}

			# Retry across replicas so the swap is invisible to clients: a request that
			# lands on a just-started replica before it's accepting connections gets a dial
			# refusal, which Caddy retries against the healthy replica within
			# lb_try_duration (nothing was written upstream yet, so this is safe to retry).
			# docker-rollout keeps the OLD replica up until the new one passes its /readyz
			# healthcheck, so there's always a warm backend to retry onto. Deliberately no
			# passive `fail_duration` / `unhealthy_status`: in steady state there's a single
			# backend, and benching it on a transient error or an app-level 5xx would
			# self-inflict an outage with no alternative to fail over to.
			lb_policy least_conn
			lb_try_duration 10s
			lb_try_interval 250ms

			transport http {
				dial_timeout 30s
			}
		}
	}
}
