# .env.example.
#
# Read by docker compose (and through it the entrypoint). NOT a shell script: no `export`,
# one line per value, no trailing backslashes.
#
# EVERY variable the compose file reads is listed. Ones this box does not set are commented
# out showing the default that already applies, so this file is also the menu of what can be
# turned on -- uncomment and set, no compose edit needed.
#
# Compose uses the LAST assignment of a key, so a duplicate silently shadows the earlier one.
# `bash env-redundant.sh` flags duplicates and entries that merely restate a default.
#
# Every secret here is a PLACEHOLDER. Replace them before use; never commit real ones.

# --------------------------------------------------------------------------------------
# Host identity and access
# --------------------------------------------------------------------------------------
DOMAIN=preview.coo.ee
SERVE_ADMIN_TOKEN=replace-me-generated-admin-token
# Optional narrower credential for UI-builder design summaries and unusable reasons only.
# SERVE_ADMIN_READ_TOKEN=
# UI Builder-only administrators, as comma-separated GitHub actor ids.
SERVE_UI_BUILDER_ADMIN_ACTORS=github:yschimke
# SERVE_UI_BUILDER_DEFAULT_VISIBILITY=public
SERVE_TOKEN=replace-me-generated-share-token
# SERVE_PUBLIC=1
# SERVE_TIMEOUT=
# SERVE_TRUST_FORWARDED_FOR=1

# Optional Umami collection, disabled even with URL/ID until explicitly enabled. See ../analytics/README.md.
# SERVE_UMAMI_ENABLED=0
# SERVE_UMAMI_URL=
# SERVE_UMAMI_WEBSITE_ID=

# --------------------------------------------------------------------------------------
# Image tags, deploy hook and rollout cadence
# --------------------------------------------------------------------------------------
DEPLOY_HOOK_TOKEN=replace-me-generated-hook-token
ROLLOUT_HEALTH_TIMEOUT=900
ROLLOUT_INTERVAL=10800
# CADDY_IMAGE_TAG=latest
# IMAGE_TAG=latest

# --------------------------------------------------------------------------------------
# GitHub sign-in (gates repo-access-limited catalogs and the agent grant lane)
# --------------------------------------------------------------------------------------
SERVE_GITHUB_AUTH_CALLBACK_BASE_URL=https://preview.coo.ee
SERVE_GITHUB_AUTH_CLIENT_ID=replace-me-github-oauth-client-id
SERVE_GITHUB_AUTH_CLIENT_SECRET=replace-me-github-oauth-client-secret
SERVE_GITHUB_AUTH_COOKIE_SECRET=replace-me-random-32-bytes
# SERVE_GITHUB_AUTH_SCOPE=read:user
# SERVE_GITHUB_AUTH_COOKIE_DOMAIN=
# SERVE_GITHUB_AUTH_REPO=yschimke/compose-ai-tools
# SERVE_GITHUB_AUTH_USERS=
# SERVE_GITHUB_AUTH_ORGS=google
# SERVE_GITHUB_AUTH_GUESTS=1
# SERVE_GITHUB_AUTH_OPEN_UI_BUILDER=1

# --------------------------------------------------------------------------------------
# UI-builder guidelines check (ui_builder_check_design `guidelines`): a model judges designs
# against the Android design guides through OpenRouter, on THIS box's key. Off unless the key is
# set and USERS or ORGS says who may spend it. Others use their own key in the editor.
# SERVE_UI_BUILDER_GUIDELINES_OPENROUTER_KEY=sk-or-...
# SERVE_UI_BUILDER_GUIDELINES_USERS=yschimke
# SERVE_UI_BUILDER_GUIDELINES_ORGS=google
# SERVE_UI_BUILDER_GUIDELINES_MODEL=deepseek/deepseek-v4.1-flash
# Seconds a guidelines prompt waits for native renders it has not cached (default 45); the rest
# keep drawing into the cache and are attached next time.
# SERVE_UI_BUILDER_GUIDELINES_PICTURE_BUDGET=45
# Before a check, ask Jev (typesafe/jev-1.13) which extra evidence would help: a dark render, a
# large-font render, the accessibility tree. `off` skips it (default on).
# SERVE_UI_BUILDER_GUIDELINES_TRIAGE=on
# SERVE_UI_BUILDER_GUIDELINES_GITHUB_TOKEN=

# --------------------------------------------------------------------------------------
# Box sizing
# Seats are auto-derived when SERVE_LIVE_SEATS is unset: min(memory over 75% of the limit,
# cores x 2), clamped [2, 32]. Pinning it ALSO suppresses the entrypoint's
# 'auto live-seat budget' log line, the only place the effective memory and core count are
# reported -- so prefer leaving it unset once the derivation suits the box.
#
# Compose takes the LAST assignment of a key: a duplicate SERVE_JAVA_OPTS silently shadows
# the one above it, which is how a set of tuned optimizer thresholds here sat dead.
# --------------------------------------------------------------------------------------
PREVIEW_MEM_LIMIT=16g
SERVE_BACKGROUND_RENDERS=3
SERVE_JAVA_OPTS=-Dcomposeai.serve.themeOptimizationIdleMillis=10000 -Dcomposeai.serve.optimizerResumeQuietMillis=30000 -Dcomposeai.serve.optimizerStopLoadPerCpu=2.0 -Dcomposeai.serve.optimizerResumeLoadPerCpu=1.2 -Dcomposeai.serve.optimizerStopCpuUtilization=0.95 -Dcomposeai.serve.optimizerResumeCpuUtilization=0.75
SERVE_LIVE_SEATS=8

# --------------------------------------------------------------------------------------
# Caches (sized in bytes; both survive a redeploy on their named volumes)
# --------------------------------------------------------------------------------------
SERVE_CATALOG_CACHE_MAX_BYTES=34359738368
# SERVE_CATALOG_CACHE_DIR=/catalog-cache
# SERVE_THEME_CACHE_DIR=/theme-cache
# SERVE_THEME_CACHE_EVICT=
# SERVE_THEME_CACHE_MAX_BYTES=4294967296

# --------------------------------------------------------------------------------------
# Catalogs: what is served, and from where
# --------------------------------------------------------------------------------------
SERVE_CATALOG_MCP=1
SERVE_CATALOG_REGISTRY=yschimke/compose-preview-imports-out
# SERVE_ALLOW_RENDER_TRUSTED=
# SERVE_CATALOGS=
# SERVE_CATALOGS_FILE=
# SERVE_CATALOGS_UNLISTED=
# SERVE_CATALOG_FEED_IDLE=
# SERVE_CATALOG_MAX_IMAGES=
# SERVE_CATALOG_REFRESH=
# SERVE_CATALOG_SOURCE_REF=
# SERVE_CATALOG_SOURCE_REPO=
# SERVE_CATALOG_SOURCE_ROOT=
# SERVE_EXTRA_MAVEN_REPOS=
# SERVE_RC_DEFAULT_PLAYER=
# SERVE_REVISIONS_ALLOW=
# SERVE_TRUST_STORE=
# SERVE_WASM_DIR=

# --------------------------------------------------------------------------------------
# Sites served from this host
# --------------------------------------------------------------------------------------
SERVE_SITES=m3.preview.coo.ee=m3-catalog,wear.preview.coo.ee=wear-m3-catalog
SITE_DOMAINS=m3.preview.coo.ee, wear.preview.coo.ee
# SERVE_ENGAGEMENT_FILE=

# --------------------------------------------------------------------------------------
# Content lanes accepted from clients
# --------------------------------------------------------------------------------------
SERVE_ACCEPT_DOCS=1
SERVE_ACCEPT_IMAGES=1
SERVE_IMAGE_UPLOAD_REPO=yschimke/compose-preview-server
# SERVE_ACCEPT_BUNDLES=
# SERVE_ACCEPT_BUNDLES_FROM=
# SERVE_ACCEPT_DOCS_FROM=
# SERVE_DOC_TTL=
# SERVE_IMAGE_RATE_LIMIT=
# SERVE_IMAGE_TTL=
# SERVE_IMAGE_UPLOAD_TOKENS=

# --------------------------------------------------------------------------------------
# Compile engine and playground (jailed compile lane)
# --------------------------------------------------------------------------------------
# The engine runs for the UI builder's native preview and inline Remote Compose capture. The
# public playground surface (`/playground`, the run route, `/pg/`, editor links) is off on this
# box; SERVE_PLAYGROUND=1 would mount it over the same engine.
SERVE_COMPILE_ENGINE=1
# SERVE_PLAYGROUND=
# To serve the public playground from its own container instead (README → "Playground in its own
# container"), add COMPOSE_PROFILES set to playground (read by Compose itself, which starts the
# `playground` service) and set the next two: caddy routes the playground's paths there, and this
# server keeps linking to it.
# PLAYGROUND_UPSTREAM=playground
# SERVE_PLAYGROUND_EXTERNAL=1
# PLAYGROUND_MEM_LIMIT=6g
# PLAYGROUND_LIVE_SEATS=
# PLAYGROUND_JAVA_OPTS=
# No pin needed: the engine selects the served catalog each design names.
# SERVE_PLAYGROUND_BUNDLE=
SERVE_PLAYGROUND_COMPILE_SLOTS=1
SERVE_PLAYGROUND_SANDBOX=bwrap
SERVE_PLAYGROUND_SANDBOX_RO=/root/.m2/repository,/root/.cache/composeai/fonts
# The editing lease is a playground editor feature and is ignored without the public surface.
# SERVE_PLAYGROUND_EDITING=0
# SERVE_PLAYGROUND_EDIT_LEASE_TTL=
# SERVE_PLAYGROUND_ANDROID_BUNDLE=
# SERVE_PLAYGROUND_CALLER_CONCURRENCY=
# SERVE_PLAYGROUND_CATALOG_LIMIT=
# SERVE_PLAYGROUND_RATE_LIMIT=
# SERVE_PLAYGROUND_SANDBOX_CPUS=
# SERVE_PLAYGROUND_SANDBOX_MEMORY_MB=
# SERVE_PLAYGROUND_SANDBOX_PIDS=
# SERVE_PLAYGROUND_SANDBOX_TTL=

# --------------------------------------------------------------------------------------
# Agent grants
# --------------------------------------------------------------------------------------
SERVE_AGENT_GRANT_CAPABILITIES=ui-builder-read,ui-builder-write,ui-builder-export,images
# Default preview,live. Was `playground` while the compile lane was on.
# SERVE_AGENT_GRANT_SCOPES=preview,live
# SERVE_AGENT_GRANTS=
# SERVE_AGENT_GRANT_MAX_ACTIVE=
# SERVE_AGENT_GRANT_MAX_TTL=
# SERVE_AGENT_GRANT_RATE_LIMIT=

# --------------------------------------------------------------------------------------
# UI Builder
# --------------------------------------------------------------------------------------
# The catalog settings below (CATALOGS, PUBLISHED_CATALOGS, CATALOG_OWNERSHIP, NATIVE_CATALOGS,
# PACKS, WIDGET_PLAYER) can instead live in catalogs.json's `uiBuilder` block, maintained over
# PUT /admin/ui-builder/config. That block OVERRIDES these per catalog and leaves the rest here, so
# a box can move one catalog at a time; see "UI-builder catalog settings" in README.md.
SERVE_UI_BUILDER_PACKS=confetti-mobile=mobile,confetti-wear=wear
# The default is `m3-catalog` alone. Name more to offer them, e.g. the full set:
# SERVE_UI_BUILDER_CATALOGS=m3-catalog,remote-m3,wear-m3,a2ui-catalog
# Set to 0 to strip wear-m3 from whatever list is in force when this box cannot carry the Wear lane.
# SERVE_UI_BUILDER_WEAR=0
# SERVE_UI_BUILDER_COMMENT_WEBHOOK=
# SERVE_UI_BUILDER_COMMENT_WEBHOOK_FORMAT=
# Web Push (docs/serve/NOTIFICATIONS.md): on wherever GitHub sign-in is configured; 0 turns it off.
# SERVE_WEB_PUSH=1
# SERVE_VAPID_SUBJECT=mailto:ops@example.com
# Pin the VAPID pair when the state directory is not durable (`npx web-push generate-vapid-keys`).
# SERVE_VAPID_PUBLIC_KEY=
# SERVE_VAPID_PRIVATE_KEY=
# SERVE_UI_BUILDER_COMPONENTS=
# SERVE_UI_BUILDER_NATIVE_CATALOGS=
# SERVE_UI_BUILDER_WIDGET_PLAYER=
# The default: which served catalogs take their definition from the catalog repository's own
# published `ui-builder.json`. An empty value falls back to it, so uncommenting this line as-is
# changes nothing; set it to a subset, or to `none`, to serve fewer from their published files.
# SERVE_UI_BUILDER_PUBLISHED_CATALOGS=remote-m3,wear-m3
# Which of those published catalogs also seed new designs from their own templates and export by
# their own declaration (compose-ui-builder docs/design/UI_BUILDER_CATALOG_CUTOVER.md): `all`,
# `none`, or a list. Unset is `none`, which changes nothing.
# SERVE_UI_BUILDER_CATALOG_OWNERSHIP=none
# SERVE_UI_BUILDER_STATE_DIR=/config/ui-builder-state

# Optional UI Builder alias. Add DNS pointing at the same host; / opens /ui-builder/.
# A sibling of preview.coo.ee needs an EXPLICIT shared cookie parent for GitHub sign-in.
# SERVE_UI_BUILDER_HOST=ui.coo.ee
# SERVE_GITHUB_AUTH_COOKIE_DOMAIN=coo.ee
# Optional /start redirect to the existing guide (not a relocated copy).
# SERVE_UI_BUILDER_START_URL=https://yschimke.github.io/compose-ui-builder/
