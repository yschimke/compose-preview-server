{
    "name": "compose-preview-server-harness",
    "version": "0.0.0",
    "private": true,
    "description": "Playwright harness for `compose-preview serve`: page captures for the visual-diff bot, and the lane / playground / bundle-upload end-to-end specs.",
    "type": "module",
    "scripts": {
        "harness:pages": "playwright test -c playwright.config.mjs pages-snapshot.spec.mjs",
        "harness:compare": "playwright test -c playwright.config.mjs format-compare-scorer.spec.mjs",
        "harness:ui-builder": "playwright test -c ui-builder.config.mjs",
        "harness:ui-builder-editor": "playwright test -c ui-builder-editor.config.mjs",
        "harness:ui-builder-renderer": "playwright test -c ui-builder-renderer.config.mjs",
        "harness:ui-builder-gate2": "playwright test -c ui-builder-gate2.config.mjs",
        "harness:ui-builder-visual-replay": "playwright test -c ui-builder-gate2.config.mjs --grep \"checked-in Jetcaster\"",
        "harness:ui-builder-performance": "playwright test -c ui-builder-performance.config.mjs",
        "harness:ui-builder-jetcaster": "playwright test -c ui-builder-jetcaster.config.mjs",
        "harness:serve-lanes": "playwright test -c serve-lanes.config.mjs",
        "harness:playground": "playwright test -c playground.config.mjs",
        "harness:bundle-upload": "playwright test -c bundle-upload.config.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "pixelmatch": "7.2.0",
        "pngjs": "7.0.0"
    }
}
