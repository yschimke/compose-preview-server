{
    "name": "compose-preview-serve-web",
    "private": true,
    "version": "0.0.0",
    "description": "Vue components for the Compose Preview server. Built to a bundle committed under server/src/main/resources so the Gradle build stays Node-free.",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json && node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc -p tsconfig.json",
        "test": "node --import tsx --import ./test/preload.ts ./node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\"",
        "format": "prettier --write --tab-width 4 package.json tsconfig.json esbuild.mjs \"scripts/*.mjs\" \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check --tab-width 4 package.json tsconfig.json esbuild.mjs \"scripts/*.mjs\" \"src/**/*.ts\" \"test/**/*.ts\"",
        "verify": "npm run typecheck && npm run test && npm run build && node scripts/check-bundle-budgets.mjs && node scripts/check-committed-bundle.mjs"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.12.2",
        "@types/mocha": "10.0.10",
        "@types/node": "24.13.3",
        "@types/three": "0.185.4",
        "@types/webxr": "0.5.24",
        "esbuild": "0.28.2",
        "happy-dom": "20.12.2",
        "mocha": "12.0.0",
        "prettier": "3.9.6",
        "three": "0.185.1",
        "tsx": "4.23.13",
        "typescript": "7.0.2",
        "vue": "3.5.42"
    }
}
