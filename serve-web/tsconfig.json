{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": [],
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        // The acceptance engine is shared, not a TypeScript port: `src/parity/` imports
        // `@design-parity/known-differences` so the browser and the offline driver run one
        // implementation rather than two that a fixture suite has to keep honest. The package ships
        // its own declarations. `allowJs` stays for the plain JavaScript this project still imports;
        // `checkJs` stays off because none of it is this project's to type-check.
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
